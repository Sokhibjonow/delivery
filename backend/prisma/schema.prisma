generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  name       String
  phone      String?
  createdAt  DateTime @default(now())

  orders Order[]
}

model Product {
  id          Int      @id @default(autoincrement())
  imageUrl    String
  name        String
  description String
  oldPrice    Int?
  newPrice    Int
  category    String
  createdAt   DateTime @default(now())
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  items     Json
  total     Int
  location  String?
  status    String   @default("kutilmoqda")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}
